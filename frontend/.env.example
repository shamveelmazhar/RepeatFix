# Copy to .env.local. With no API URL (or USE_MOCKS=true) the UI uses the fixtures in mocks/.
# Our backend runs on port 8001 (vLLM has 8000). Set USE_MOCKS=false to use it; anything it
# doesn't have yet falls back to the fixtures, and a banner says which parts.
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_USE_MOCKS=true
