# Backend: the model API (AMD Token Factory)
VLLM_BASE_URL=https://<token-factory-endpoint>/v1
VLLM_API_KEY=
VLLM_MODEL=DeepSeek-V4-Flash
GPU_LABEL=AMD GPUs via AMD Token Factory
ALLOWED_ORIGINS=
# Frontend (copy these to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_USE_MOCKS=true
